#!/usr/bin/env bash
# Review-ladder smoke for consensus-gate: runs the recipe with a stubbed agent() and checks the
# pass rule (L1 never passes; a void or L0-failed round never passes), args, and the round's OUT path.
set -u
W="$(CDPATH= cd -- "$(dirname -- "$0")/../skills/using-workflows/workflows" && pwd)"
node --input-type=module - "$W/consensus-gate.workflow.js" <<'EOF'
import fs from 'node:fs'
const body = fs.readFileSync(process.argv[2], 'utf8').replace(/^export const meta/m, 'const meta')
const AsyncFn = Object.getPrototypeOf(async () => {}).constructor
const run = async (args, reply) => {
  let prompt = ''
  const agent = async (p) => { prompt = p; return { ok: true, verdict: 'v', consensus: 'agree', notes: '', manifest_before: M1, manifest_after: M1, l0_rc: 0, l0_output: '', ...reply } }
  const out = await new AsyncFn('args', 'agent', 'phase', 'log', body)(JSON.stringify(args), agent, () => {}, () => {})
  return { out, prompt }
}
const M1 = 'head h1\ndiff d1\nfreeze f1'
const base = { proposalFile: '/abs/p.md', cli: 'codex', sessionName: 'g1' }
let fail = 0
const check = (name, ok, got) => { if (!ok) fail = 1; console.log(`${ok ? 'ok  ' : 'FAIL'} ${name}${ok ? '' : ` — got: ${got}`}`) }
{ const { out } = await run(base, {}); check('L2 agree with stable manifest passes', out.passed === true, JSON.stringify(out)) }
{ const { out } = await run({ ...base, layer: 'L1' }, {}); check('L1 agree never passes (pre-filter)', out.passed === false && out.prefilter === true, JSON.stringify(out)) }
{ const { out } = await run(base, { manifest_after: 'head h1\ndiff d1\nfreeze f2' }); check('manifest change voids the round and names the part', out.passed === false && out.voided === true && out.voidedBy.join() === 'freeze', JSON.stringify(out)) }
{ const { out } = await run(base, { manifest_before: 'm1', manifest_after: 'm1' }); check('an incomplete manifest voids (invalid-manifest)', out.passed === false && out.voidedBy.join() === 'invalid-manifest', JSON.stringify(out)) }
{ const { out, prompt } = await run(base, {}); check('OUT is under the repo run dir, not /tmp', /\.workflow\/consensus-gate\/codex-g1-r1\.md$/.test(out.out) && !/\/tmp\//.test(prompt), out.out) }
{ const { out } = await run({ ...base, l0: 'scripts/x' }, { l0_rc: 1 }); check('L0 failure fails the gate', out.passed === false && out.l0Failed === true, JSON.stringify(out)) }
{ const { out } = await run(base, { consensus: 'agree_with_changes' }); check('agree_with_changes does not pass', out.passed === false, JSON.stringify(out)) }
{ const { prompt } = await run({ ...base, round: 2 }, {}); check('round 2 writes its own OUT and never deletes', /-g1-r2\.md/.test(prompt) && !/[Dd]elete OUT/.test(prompt), prompt.slice(0, 300)) }
{ const { prompt } = await run(base, {}); check('manifest hashes HEAD, diff and the proposal file', /rev-parse HEAD/.test(prompt) && /diff HEAD/.test(prompt) && /for f in '\/abs\/p\.md'; do .*shasum -a 256 < "\$f"/.test(prompt), prompt) }
{ const { prompt } = await run({ ...base, l0: 'scripts/x' }, {}); check('the reviewer task carries the L0 result', /then the L0 result from step 1 \(l0_rc and l0_output, verbatim\)/.test(prompt), prompt.slice(0, 600)) }
{ const { prompt } = await run(base, {}); check('round 1 assigns a mod worker and awaits it, never agent-tmux through Bash', /mcp__tmux-agent__assign \{profile: "codex", name: "g1"/.test(prompt) && /mcp__tmux-agent__await/.test(prompt) && /Never run agent-tmux through Bash/.test(prompt) && !/mcp__tmux-agent__tell \{/.test(prompt), prompt.slice(0, 600)) }
{ const { prompt, out } = await run({ ...base, round: 2, worker: 'g1.k3x9a' }, { worker: 'g1.k3x9a' }); check('round 2 tells the returned worker and returns it', /mcp__tmux-agent__tell \{name: "g1\.k3x9a"/.test(prompt) && !/mcp__tmux-agent__assign \{/.test(prompt) && out.worker === 'g1.k3x9a', prompt.slice(0, 600)) }
for (const [k, v] of [['layer', 'L4'], ['layer', 'L3'], ['round', 0], ['freeze', ['a\nb']], ['worker', 'a b'], ['launchEnv', 'X=1 ']]) {
  const { out } = await run({ ...base, [k]: v }, {}); check(`rejects ${k}=${JSON.stringify(v)}`, out.aborted === true, JSON.stringify(out))
}
{ const { out, prompt } = await run({ ...base, freeze: ["a b; rm 'x"] }, {}); check('a freeze path with spaces, ; and a quote is single-quoted, not run', !out.aborted && prompt.includes("'a b; rm '\\''x'"), prompt.slice(0, 200)) }
console.log(fail ? 'FAIL consensus-gate-ladder' : 'PASS consensus-gate-ladder')
process.exit(fail)
EOF
