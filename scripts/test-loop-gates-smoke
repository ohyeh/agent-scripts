#!/usr/bin/env bash
# Smoke for the W38 loop gates: compaction-cap-gate, wakeup-idle-gate, and the
# single-file postcompact-handoff. Each case is the smallest input that fails
# if the logic breaks. Runs against the repo copies with HOME redirected.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d -t loop-gates-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT
export HOME="$WORK/fakehome" XDG_STATE_HOME="$WORK/fakehome/.local/state" XDG_DATA_HOME="$WORK/fakehome/.local/share"
mkdir -p "$HOME"
PASS=0; FAIL=0
ok()   { echo "  ok   $1"; PASS=$((PASS + 1)); }
fail() { echo "  FAIL $1" >&2; FAIL=$((FAIL + 1)); }
expect_exit() { # $1 label, $2 expected code, then the command...
  local label="$1" want="$2" got=0; shift 2
  "$@" >/dev/null 2>"$WORK/stderr" || got=$?
  if [ "$got" = "$want" ]; then ok "$label (exit $got)"; else fail "$label: exit $got, want $want: $(head -c 200 "$WORK/stderr")"; fi
}

# --- transcripts: 3 compactions (under cap) and 20 (at cap)
under="$WORK/under.jsonl"; at="$WORK/at.jsonl"
for _ in 1 2 3; do echo '{"type":"user","isCompactSummary":true}'; done > "$under"
for _ in $(seq 20); do echo '{"type":"user","isCompactSummary":true}'; done > "$at"

cap() { # $1 transcript, $2 tool_name, $3 tool_input json
  printf '%s' "$(jq -cn --arg t "$1" --arg n "$2" --argjson i "$3" '{session_id:"cap-smoke",transcript_path:$t,tool_name:$n,tool_input:$i}')" |
    bash "$ROOT/.agents/hooks/compaction-cap-gate.sh"
}
echo "case: compaction-cap-gate"
expect_exit "under cap: Edit src allowed"              0 cap "$under" Edit '{"file_path":"/repo/src/a.ts"}'
expect_exit "at cap: Edit src BLOCKED"                 2 cap "$at"    Edit '{"file_path":"/repo/src/a.ts"}'
expect_exit "at cap: Write handoff allowed"            0 cap "$at"    Write '{"file_path":"/repo/.claude/handoffs/2026-09-18-x.md"}'
expect_exit "at cap: git commit allowed"               0 cap "$at"    Bash '{"command":"git commit -m \"docs(handoff): x\""}'
expect_exit "at cap: npm test BLOCKED"                 2 cap "$at"    Bash '{"command":"npm test"}'
expect_exit "at cap: ScheduleWakeup stop allowed"      0 cap "$at"    ScheduleWakeup '{"stop":true}'
expect_exit "at cap: ScheduleWakeup 1800 BLOCKED"      2 cap "$at"    ScheduleWakeup '{"delaySeconds":1800,"noop":true,"prompt":"x"}'
grep -q 'BLOCKED: this session has compacted 20 times' "$WORK/stderr" && ok "block message names the count" || fail "block message missing count"
expect_exit "env cap 22 → 20 compactions allowed"     0 env AGENT_HOOKS_MAX_COMPACTIONS=22 bash -c 'printf "%s" "$(jq -cn --arg t "$1" "{session_id:\"cap-smoke\",transcript_path:\$t,tool_name:\"Edit\",tool_input:{file_path:\"/repo/src/a.ts\"}}")" | bash "$2"' _ "$at" "$ROOT/.agents/hooks/compaction-cap-gate.sh"
n="$(grep -c '"result":"blocked"' "$XDG_DATA_HOME/agent-hooks/compaction-cap-stats.jsonl")"
[ "$n" = 3 ] && ok "stats: 3 blocked rows logged" || fail "stats: $n blocked rows, want 3"

# --- wakeup-idle-gate: streak of noops
idle() { # $1 tool_input json, [$2 session]
  printf '%s' "$(jq -cn --arg s "${2:-idle-smoke}" --argjson i "$1" '{session_id:$s,tool_name:"ScheduleWakeup",tool_input:$i}')" |
    bash "$ROOT/.agents/hooks/wakeup-idle-gate.sh"
}
echo "case: wakeup-idle-gate"
expect_exit "noop #1 allowed"                          0 idle '{"delaySeconds":1500,"noop":true,"prompt":"x","reason":"waiting"}'
expect_exit "noop #2 allowed"                          0 idle '{"delaySeconds":1500,"noop":true,"prompt":"x","reason":"waiting"}'
expect_exit "noop #3 at 1500s BLOCKED"                 2 idle '{"delaySeconds":1500,"noop":true,"prompt":"x","reason":"waiting"}'
grep -q 'PushNotification' "$WORK/stderr" && grep -q 'self-improvement' "$WORK/stderr" && ok "block message names both exits" || fail "block message missing an exit"
expect_exit "noop #3 at 3600s allowed"                 0 idle '{"delaySeconds":3600,"noop":true,"prompt":"x","reason":"waiting"}'
expect_exit "noop #4 at 1200s BLOCKED (streak persists)" 2 idle '{"delaySeconds":1200,"noop":true,"prompt":"x"}'
expect_exit "real work (noop:false) resets, allowed"   0 idle '{"delaySeconds":600,"noop":false,"prompt":"x"}'
[ "$(cat "$XDG_STATE_HOME/agent-hooks/idle-smoke/wakeup-noop-streak")" = 0 ] && ok "streak reset to 0" || fail "streak not reset"
expect_exit "stop:true always allowed"                 0 idle '{"stop":true}'
expect_exit "other session starts at streak 0"         0 idle '{"delaySeconds":900,"noop":true,"prompt":"x"}' other-sid

# --- postcompact-handoff: one file per session, overwritten
echo "case: postcompact-handoff single file"
repo="$WORK/repo"; mkdir -p "$repo"
pc() { printf '%s' "$(jq -cn --arg c "$repo" --arg t "$at" --arg s "$1" '{session_id:"abcdef1234567890",cwd:$c,trigger:"auto",transcript_path:$t,compact_summary:$s}')" | bash "$ROOT/.agents/hooks/postcompact-handoff.sh" >/dev/null; }
pc "first summary"; pc "second summary"
n="$(ls "$repo/.claude/handoffs" | wc -l | tr -d ' ')"
[ "$n" = 1 ] && ok "two compactions → 1 file" || fail "two compactions → $n files"
[ -f "$repo/.claude/handoffs/compact-abcdef12.md" ] && ok "file named compact-<sid8>.md" || fail "file name wrong: $(ls "$repo/.claude/handoffs")"
grep -q 'second summary' "$repo/.claude/handoffs/compact-abcdef12.md" && ok "latest summary wins" || fail "old summary kept"
grep -q 'Compactions so far: 20' "$repo/.claude/handoffs/compact-abcdef12.md" && ok "compaction count recorded" || fail "count line missing"

# --- postcompact-handoff: correlation fields + standing-authorization check
echo "case: postcompact-handoff correlation fields"
tr2="$WORK/meta.jsonl"
printf '%s\n' '{"type":"bridge-session","bridgeSessionId":"cse_TEST"}' \
  '{"type":"assistant","version":"9.9.9","entrypoint":"cli","advisorModel":"adv-x","effort":"medium","message":{"model":"model-y"}}' \
  '{"type":"assistant","message":{"model":"<synthetic>"}}' > "$tr2"
git -C "$repo" init -q && git -C "$repo" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
pcm() { printf '%s' "$(jq -cn --arg c "$repo" --arg t "$1" --arg s "$2" '{session_id:"feedbeef00000000",cwd:$c,trigger:"auto",transcript_path:$t,compact_summary:$s}')" | bash "$ROOT/.agents/hooks/postcompact-handoff.sh"; }
st="$(pcm "$tr2" "no auth heading here")"
hf="$repo/.claude/handoffs/compact-feedbeef.md"
grep -q 'Cloud session: cse_TEST' "$hf" && ok "cloud session id" || fail "cloud session missing"
grep -q 'CLI: claude-code 9.9.9 (entrypoint cli)' "$hf" && ok "cli + version" || fail "cli line wrong: $(grep CLI "$hf")"
grep -q 'Model: model-y · effort medium · advisor adv-x' "$hf" && ok "model/effort/advisor, synthetic skipped" || fail "model line wrong: $(grep Model "$hf")"
grep -q "Git: .* @ $(git -C "$repo" rev-parse HEAD)" "$hf" && ok "git full commit sha" || fail "git line wrong: $(grep Git: "$hf")"
case "$st" in *"no Standing Authorizations section"*) ok "missing auth section flagged" ;; *) fail "auth section not flagged: $st" ;; esac
pcm "$WORK/absent.jsonl" "x" >/dev/null
grep -q 'Compactions so far: 0 (' "$hf" && ok "no transcript → single 0" || fail "count wrong: $(grep Compactions "$hf")"

# --- compaction-recall points at the single file
echo "case: compaction-recall handoff pointer"
out="$(printf '%s' "$(jq -cn --arg c "$repo" --arg t "$at" '{session_id:"abcdef1234567890",cwd:$c,transcript_path:$t}')" | bash "$ROOT/.agents/hooks/compaction-recall.sh" 2>/dev/null || true)"
# transcript has no human prompts → recall exits early; add one and retry
echo '{"type":"user","message":{"content":"ship the thing"}}' >> "$at"
out="$(printf '%s' "$(jq -cn --arg c "$repo" --arg t "$at" '{session_id:"abcdef1234567890",cwd:$c,transcript_path:$t}')" | bash "$ROOT/.agents/hooks/compaction-recall.sh")"
printf '%s' "$out" | grep -q 'compact-abcdef12.md' && ok "recall names compact-<sid8>.md" || fail "recall pointer wrong: $(printf '%s' "$out" | grep -i handoff)"
printf '%s' "$out" | grep -q 'BLOCKED by compaction-cap-gate' && ok "recall ESCALATION names the gate" || fail "ESCALATION text stale"

# --- subagent: own transcript, never the parent's (86a74915 worker got the owner's prompts)
echo "case: subagent compaction hooks"
parent="$WORK/parent.jsonl"; sub="$WORK/parent/subagents/agent-a1b2c3.jsonl"; mkdir -p "$(dirname "$sub")"
printf '%s\n' '{"type":"user","message":{"content":"owner prompt for the commander"}}' > "$parent"
for _ in $(seq 20); do echo '{"type":"user","isCompactSummary":true}'; done >> "$parent"
printf '%s\n' '{"type":"user","message":{"content":"GOAL: worker brief"}}' '{"type":"user","isCompactSummary":true}' > "$sub"
rin() { printf '%s' "$(jq -cn --arg c "$repo" --arg t "$parent" --arg a "$1" '{session_id:"abcdef1234567890",cwd:$c,transcript_path:$t,agent_id:$a}')" | bash "$ROOT/.agents/hooks/compaction-recall.sh"; }
out="$(rin a1b2c3)"
printf '%s' "$out" | grep -q 'GOAL: worker brief' && ok "worker recall = its own brief" || fail "worker brief missing: $out"
printf '%s' "$out" | grep -q 'owner prompt' && fail "worker got the parent's prompt" || ok "parent prompt not injected"
printf '%s' "$out" | grep -q 'compact-abcdef12.md' && fail "worker pointed at the parent's handoff" || ok "no parent handoff pointer"
out="$(rin zzz999)"; [ -z "$out" ] && ok "no own transcript → inject nothing" || fail "missing worker file injected: $out"
grep -q '"own_transcript_found":false' "$XDG_DATA_HOME/agent-hooks/compaction-recall-subagent.jsonl" && ok "subagent branch logged" || fail "subagent branch not logged"
before="$(cat "$repo/.claude/handoffs/compact-abcdef12.md")"
printf '%s' "$(jq -cn --arg c "$repo" --arg t "$parent" '{session_id:"abcdef1234567890",agent_id:"a1b2c3",cwd:$c,trigger:"auto",transcript_path:$t,compact_summary:"WORKER SUMMARY"}')" | bash "$ROOT/.agents/hooks/postcompact-handoff.sh" >/dev/null
[ "$(cat "$repo/.claude/handoffs/compact-abcdef12.md")" = "$before" ] && ok "worker compaction leaves the parent handoff untouched" || fail "parent handoff overwritten"
capsub() { printf '%s' "$(jq -cn --arg t "$parent" --arg a "$1" '{session_id:"cap-smoke",transcript_path:$t,agent_id:$a,tool_name:"Edit",tool_input:{file_path:"/repo/src/a.ts"}}')" | bash "$ROOT/.agents/hooks/compaction-cap-gate.sh"; }
expect_exit "parent at cap, worker at 1: worker Edit allowed" 0 capsub a1b2c3

# --- compaction hooks get no agent_id inside a subagent (probe 2026-10-17): the
# PreCompact mark from the newest ledger row decides the thread
echo "case: compacting-thread mark"
rundir="$HOME/.local/state/agent-hooks/abcdef1234567890"; mkdir -p "$rundir"
ledger_row() { jq -cn --arg ts "$1" --arg a "$2" '{timestamp:$ts,tool:"Read",agent_id:(if $a == "" then null else $a end)}' > "$rundir/ledger.jsonl"; }
precompact() { jq -cn --arg tr "$1" '{session_id:"abcdef1234567890",trigger:$tr}' | bash "$ROOT/.agents/hooks/precompact-instructions.sh" >/dev/null; }
rmark() { printf '%s' "$(jq -cn --arg c "$repo" --arg t "$parent" '{session_id:"abcdef1234567890",cwd:$c,transcript_path:$t,source:"compact"}')" | bash "$ROOT/.agents/hooks/compaction-recall.sh"; }
now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
ledger_row "$now" a1b2c3; precompact auto
[ "$(cat "$rundir/compacting-thread")" = a1b2c3 ] && ok "fresh worker row → mark names the worker" || fail "mark: $(cat "$rundir/compacting-thread")"
out="$(rmark)"
printf '%s' "$out" | grep -q 'GOAL: worker brief' && ! printf '%s' "$out" | grep -q 'owner prompt' && ok "no agent_id in stdin: recall follows the mark" || fail "mark-driven recall wrong: $out"
printf '%s' "$(jq -cn --arg c "$repo" --arg t "$parent" '{session_id:"abcdef1234567890",cwd:$c,trigger:"auto",transcript_path:$t,compact_summary:"WORKER SUMMARY 2"}')" | bash "$ROOT/.agents/hooks/postcompact-handoff.sh" >/dev/null
[ "$(cat "$repo/.claude/handoffs/compact-abcdef12.md")" = "$before" ] && ok "mark-driven PostCompact leaves the parent handoff" || fail "parent handoff overwritten via mark path"
ledger_row "$now" ""; precompact auto
[ "$(cat "$rundir/compacting-thread")" = main ] && ok "main-thread row → mark main" || fail "main row mark: $(cat "$rundir/compacting-thread")"
rmark | grep -q 'owner prompt' && ok "main compaction recalls the parent's prompts" || fail "main recall lost"
ledger_row "$now" a1b2c3; precompact manual
[ "$(cat "$rundir/compacting-thread")" = main ] && ok "manual /compact → main" || fail "manual not main"
ledger_row "2026-01-01T00:00:00Z" a1b2c3; precompact auto
[ "$(cat "$rundir/compacting-thread")" = main ] && ok "stale worker row (>30s) → main" || fail "stale row named the worker"
long_brief="GOAL: worker brief $(printf 'x%.0s' $(seq 600)) ACCEPTANCE: 中文驗收條件 all green"
printf '%s\n' "$(jq -cn --arg c "$long_brief" '{type:"user",message:{content:$c}}')" '{"type":"user","message":{"content":"coordinator follow-up"}}' > "$sub"
out="$(rin a1b2c3)"
printf '%s' "$out" | grep -q 'ACCEPTANCE: 中文驗收條件 all green' && ok "worker brief keeps ACCEPTANCE past 200 chars" || fail "brief cut: $(printf '%s' "$out" | head -c 300)"
[ "$(printf '%s' "$out" | grep -c 'GOAL: worker brief')" = 1 ] && ok "brief not repeated in the prompt list" || fail "brief listed twice"
printf '%s' "$out" | grep -q '^- coordinator follow-up' && ok "follow-ups still listed" || fail "follow-up missing"
rm -f "$rundir/ledger.jsonl"
err="$(jq -cn '{session_id:"abcdef1234567890",trigger:"auto"}' | bash "$ROOT/.agents/hooks/precompact-instructions.sh" 2>&1 >/dev/null)"
[ "$(cat "$rundir/compacting-thread")" = main ] && [ -z "$err" ] && ok "no ledger → mark main, no stderr" || fail "no-ledger path: mark=$(cat "$rundir/compacting-thread") err=$err"

# --- claim-evidence-gate: a conditional/future or wait-only clause is not a claim (W45-16, retro L42).
# Window = one Edit after the human prompt and no evidence token, so any positive claim blocks.
echo "case: claim-evidence-gate conditional claim"
ctr="$WORK/claim.jsonl"; echo '{"type":"user","timestamp":"2026-01-01T00:00:00.000Z","message":{"content":"x"}}' > "$ctr"
claim() { # $1 reply → block | empty; one session per locale, since the gate fires once per (session, reply)
  local d="$HOME/.local/state/agent-hooks/claim-$LC_ALL"; mkdir -p "$d"
  echo '{"timestamp":"2026-01-01T00:00:05Z","tool":"Edit","evidence":[]}' > "$d/ledger.jsonl"
  jq -cn --arg t "$ctr" --arg m "$1" --arg s "claim-$LC_ALL" '{session_id:$s,transcript_path:$t,stop_hook_active:false,last_assistant_message:$m}' |
    bash "$ROOT/.agents/hooks/claim-evidence-gate.sh" | jq -r '.decision // empty'
}
for loc in en_US.UTF-8 C; do
  for m in '審查 PASS 後才上傳' '等測試完成再上傳。' '測試通過後才上傳' 'After the tests pass, I will publish.' \
    'Waiting for the reviewer to complete.' '等 worker 完成，再回報。' 'still running, no result yet' 'When done, I will report.' \
    '如果測試已通過就上傳。' '等測試完成了再上傳。' 'If the task were done, I would deploy.'; do
    [ -z "$(LC_ALL=$loc claim "$m")" ] && ok "not a claim ($loc): $m" || fail "conditional/wait sentence blocked ($loc): $m"
  done
  for m in '修好了，應該沒問題' 'Fixed after the retry.' '審查 PASS 後才上傳；W45-16 已完成' '等測試完成再上傳，W45-16 已完成' 'A、B 等都已完成' 'Done. Will push next.' \
    'After I fixed the bug, I pushed.' 'Once I verified it, the suite went green.' '我修好之後就 push 了' \
    '測試通過後，部署了' '我把 bug 修好後，push 了' '等了很久終於完成' \
    'Before lunch the patch was done.' 'After I fixed it tests went green.' '若干任務已完成' \
    '等待的任務已完成' '等到測試完成了，已經部署了'; do
    [ "$(LC_ALL=$loc claim "$m")" = block ] && ok "real claim, no evidence BLOCKED ($loc): $m" || fail "real claim without evidence passed ($loc): $m"
  done
done

echo "summary: $PASS passed, $FAIL failed"
[ "$FAIL" = 0 ]
