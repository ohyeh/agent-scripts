#!/usr/bin/env bash
# Regression smoke for the A2/A5 hooks: one valid JSON object per physical line.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WORK="$(mktemp -d -t agent-hooks-jsonl-smoke.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT
TEST_HOME="$WORK/home"
TEST_DATA="$WORK/data"
mkdir -p "$TEST_HOME" "$TEST_DATA"

check_jsonl() {
  local file="$1" expected_lines="$2" filter="$3" line count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    count=$((count + 1))
    printf '%s\n' "$line" | jq -e "$filter" >/dev/null
  done < "$file"
  [[ "$count" -eq "$expected_lines" ]]
}

run_bol() { # $1 prompt, $2 session_id (optional), $3 subagent_type (optional); returns the hook's exit code
  local prompt="$1" sid="${2:-}" st="${3:-general-purpose}"
  printf '%s' "$(jq -cn --arg p "$prompt" --arg sid "$sid" --arg st "$st" \
    '{tool_name:"Agent",session_id:$sid,tool_input:{prompt:$p,subagent_type:$st}}')" |
    HOME="$TEST_HOME" XDG_DATA_HOME="$TEST_DATA" XDG_STATE_HOME="$TEST_HOME/.local/state" \
    bash "$ROOT/.agents/hooks/bol-prompt-gate.sh" >/dev/null 2>&1
}
run_ledger_event() { # $1 event, $2 session_id, $3 agent_id
  printf '%s' "$(jq -cn --arg ev "$1" --arg sid "$2" --arg aid "$3" \
    '{hook_event_name:$ev,session_id:$sid,agent_id:$aid,agent_type:"general-purpose"}')" |
    HOME="$TEST_HOME" XDG_STATE_HOME="$TEST_HOME/.local/state" bash "$ROOT/.agents/hooks/subagent-ledger.sh"
}

# bill of lading: complete brief passes, incomplete brief is DENIED (exit 2), Explore is exempt
run_bol 'GOAL: ship it ACCEPTANCE: tests pass REPORT: evidence' || { echo "FAIL: complete brief was blocked" >&2; exit 1; }
if run_bol 'GOAL: ship it'; then echo "FAIL: incomplete brief was not blocked" >&2; exit 1; fi
run_bol 'where is the config loader?' '' Explore || { echo "FAIL: Explore lookup was blocked" >&2; exit 1; }
check_jsonl "$TEST_DATA/agent-hooks/bol-prompt-stats.jsonl" 3 \
  'type == "object" and (.timestamp | type) == "string" and (.result == "pass" or .result == "fail" or .result == "exempt") and (.missing | type) == "array" and (.blocked | type) == "boolean"'

# concurrency: 5 live subagents deny the 6th dispatch; a SubagentStop frees a slot
SID="bol-concurrency-smoke"
for i in 1 2 3 4 5; do run_ledger_event SubagentStart "$SID" "agent-$i"; done
[[ "$(ls "$TEST_HOME/.local/state/agent-hooks/$SID/subagents" | wc -l | tr -d ' ')" == 5 ]]
run_conc() { # $1 session_id
  printf '%s' "$(jq -cn --arg sid "$1" '{tool_name:"Agent",session_id:$sid,tool_input:{prompt:"GOAL: g ACCEPTANCE: a REPORT: r",subagent_type:"general-purpose"}}')" |
    HOME="$TEST_HOME" XDG_DATA_HOME="$TEST_DATA" XDG_STATE_HOME="$TEST_HOME/.local/state" bash "$ROOT/.agents/hooks/subagent-concurrency-gate.sh" >/dev/null 2>&1
}
if run_conc "$SID"; then echo "FAIL: 6th concurrent dispatch was not blocked" >&2; exit 1; fi
run_bol 'GOAL: g ACCEPTANCE: a REPORT: r' "$SID" || { echo "FAIL: bol gate still denies on concurrency (split violated)" >&2; exit 1; }
run_ledger_event SubagentStop "$SID" "agent-3"
run_conc "$SID" || { echo "FAIL: dispatch blocked with 4 live subagents" >&2; exit 1; }
grep -c '"result":"concurrency"' "$TEST_DATA/agent-hooks/bol-prompt-stats.jsonl" | grep -qx 1 || { echo "FAIL: concurrency stat not logged exactly once" >&2; exit 1; }

run_ledger() {
  printf '%s' "$1" |
    HOME="$TEST_HOME" bash "$ROOT/.agents/hooks/context-ledger.sh" >/dev/null 2>&1
}

run_ledger '{"session_id":"jsonl-smoke","tool_name":"Read","tool_input":{"file_path":"one.md"}}'
run_ledger '{"session_id":"jsonl-smoke","tool_name":"Edit","tool_input":{"file_path":"two.md"}}'
check_jsonl "$TEST_HOME/.local/state/agent-hooks/jsonl-smoke/ledger.jsonl" 2 \
  'type == "object" and (.timestamp | type) == "string" and (.tool | type) == "string" and (.input_sha256 | test("^[0-9a-f]{64}$")) and .evidence == []'
# evidence tokens: normalized shapes only, never surrounding output (secrets stay out)
run_ledger "$(jq -cn '{session_id:"jsonl-smoke",tool_name:"Bash",tool_input:{command:"make test"},tool_response:{stdout:"token=TEST_SECRET_123\nexit code 0\n18/18 passed\nPASS [hooks] ok\n463 tests passed",stderr:"",interrupted:false}}')"
tail -1 "$TEST_HOME/.local/state/agent-hooks/jsonl-smoke/ledger.jsonl" | jq -e '.evidence == ["18/18 passed","463 passed","PASS","exit=0"]' >/dev/null || { echo "FAIL: evidence tokens not normalized: $(tail -1 "$TEST_HOME/.local/state/agent-hooks/jsonl-smoke/ledger.jsonl")" >&2; exit 1; }
! grep -q 'TEST_SECRET_123' "$TEST_HOME/.local/state/agent-hooks/jsonl-smoke/ledger.jsonl"

audit_command='cat README.md && curl -H Authorization:Bearer_TEST_SECRET_123 example.invalid'
printf '%s' "$(jq -cn --arg command "$audit_command" '{session_id:"jsonl-smoke",tool_name:"Bash",tool_input:{command:$command}}')" |
  HOME="$TEST_HOME" bash "$ROOT/.agents/hooks/bash-read-audit.sh"
audit_file="$TEST_HOME/.local/state/agent-hooks/jsonl-smoke/read-audit.jsonl"
check_jsonl "$audit_file" 1 \
  'type == "object" and .kind == "bash-read" and .read_tool == "cat" and (.command_sha256 | test("^[0-9a-f]{64}$")) and (has("command") | not)'
! grep -q 'TEST_SECRET_123' "$audit_file"

run_device_gate() {
  local command="$1"
  printf '%s' "$(jq -cn --arg command "$command" '{tool_name:"Bash",tool_input:{command:$command}}')" |
    HOME="$TEST_HOME" bash "$ROOT/.agents/hooks/agent-device-target-gate.sh" >/dev/null 2>&1
}
run_device_gate 'agent-device open MyApp --platform ios --device phone'
run_device_gate 'agent-device open MyApp --platform web'
if run_device_gate 'agent-device open MyApp --platform ios; printf -- --device'; then
  echo "FAIL: sibling --device token bypassed agent-device gate" >&2
  exit 1
fi

# compaction recall: re-injects verbatim user prompts, skips tool_result/<tags>/its own header, escalates at 3 compactions
TR="$WORK/transcript.jsonl"
{
  echo '{"type":"user","message":{"content":"uat = staging 記得改"}}'
  echo '{"type":"user","message":{"content":[{"type":"tool_result","content":"noise"}]}}'
  echo '{"type":"user","message":{"content":"<system-reminder>skip me</system-reminder>"}}'
  echo '{"type":"user","message":{"content":"[compaction-recall] verbatim user prompts before this compaction, newest last: - old injection"}}'
  echo '{"type":"user","isCompactSummary":true,"message":{"content":"summary text"}}'
  echo '{"type":"user","message":{"content":[{"type":"text","text":"快點測試 驗證"}]}}'
} > "$TR"
run_recall() { printf '%s' "$(jq -cn --arg t "$TR" '{hook_event_name:"SessionStart",source:"compact",transcript_path:$t}')" | bash "$ROOT/.agents/hooks/compaction-recall.sh"; }
out="$(run_recall)"
grep -q -- '- uat = staging 記得改' <<<"$out" || { echo "FAIL: recall dropped a user prompt" >&2; exit 1; }
grep -q -- '- 快點測試 驗證' <<<"$out" || { echo "FAIL: recall dropped a text-block prompt" >&2; exit 1; }
grep -q 'noise\|skip me\|old injection' <<<"$out" && { echo "FAIL: recall leaked tool_result/tag/self output" >&2; exit 1; }
grep -q 'ESCALATION' <<<"$out" && { echo "FAIL: escalated at 1 compaction" >&2; exit 1; }
for i in 2 3; do echo '{"type":"user","isCompactSummary":true,"message":{"content":"s"}}' >> "$TR"; done
grep -q 'ESCALATION: this session has compacted 3 times' <<<"$(run_recall)" || { echo "FAIL: no escalation at 3 compactions" >&2; exit 1; }
for i in $(seq 1 60); do printf '{"type":"user","message":{"content":"%s"}}\n' "$(head -c 300 /dev/zero | tr '\0' x)" >> "$TR"; done
[[ "$(run_recall | wc -c)" -le 6100 ]] || { echo "FAIL: recall exceeded byte cap" >&2; exit 1; }

# title sentinel: title-only again — a ✅ title is the claim gate's business
TR2="$WORK/transcript-short.jsonl"
printf '%s\n' '{"type":"user","message":{"content":"hi"}}' '{"type":"custom-title","customTitle":"✅ foo — shipped · .1-abcd1234"}' > "$TR2"
out="$(printf '%s' "$(jq -cn --arg t "$TR2" '{session_id:"ts-1",transcript_path:$t,stop_hook_active:false,last_assistant_message:"改好了 應該沒問題"}')" | HOME="$TEST_HOME" bash "$ROOT/.agents/hooks/session-title-sentinel.sh")"
[[ -z "$out" ]] || { echo "FAIL: title sentinel acted on a claim (not its job): $out" >&2; exit 1; }

# claim-evidence gate: claims are bound to the ledger by token equality
TR3="$WORK/transcript-claim.jsonl"
printf '%s\n' '{"type":"user","timestamp":"2026-01-01T00:00:00.000Z","message":{"content":"修好它"}}' > "$TR3"
ledger_for() { # $1 sid, then JSON lines
  local d="$TEST_HOME/.local/state/agent-hooks/$1"; mkdir -p "$d"; shift; printf '%s\n' "$@" > "$d/ledger.jsonl"
}
run_claim() { # $1 sid, $2 last_assistant_message, [$3 transcript]
  printf '%s' "$(jq -cn --arg t "${3:-$TR3}" --arg m "$2" --arg sid "$1" '{session_id:$sid,transcript_path:$t,stop_hook_active:false,last_assistant_message:$m}')" |
    HOME="$TEST_HOME" bash "$ROOT/.agents/hooks/claim-evidence-gate.sh" | jq -r '.decision // empty'
}
BEFORE='{"timestamp":"2025-12-31T23:59:00Z","tool":"Bash","evidence":["exit=0"]}'
RUN0='{"timestamp":"2026-01-01T00:00:05Z","tool":"Bash","evidence":["exit=0","18/18 passed"]}'
READ='{"timestamp":"2026-01-01T00:00:06Z","tool":"Read","evidence":[]}'
ledger_for c1 "$BEFORE";           [[ "$(run_claim c1 '修好了，應該沒問題')" == block ]]            || { echo "FAIL: claim with nothing run not blocked" >&2; exit 1; }
ledger_for c2 "$BEFORE" "$RUN0";   [[ "$(run_claim c2 '修好了，應該沒問題')" == block ]]            || { echo "FAIL: claim quoting no token not blocked" >&2; exit 1; }
ledger_for c3 "$BEFORE" "$RUN0";   [[ "$(run_claim c3 'Fixed. `npm test` exit 1')" == block ]]        || { echo "FAIL: mismatched token not blocked" >&2; exit 1; }
ledger_for c4 "$BEFORE" "$RUN0";   [[ -z "$(run_claim c4 'Fixed. `npm test` → exit 0, 18/18 passed')" ]] || { echo "FAIL: bound claim blocked" >&2; exit 1; }
ledger_for c5 "$BEFORE";           [[ -z "$(run_claim c5 'not done yet, still tracing')" ]]           || { echo "FAIL: negated claim blocked" >&2; exit 1; }
ledger_for c6 "$BEFORE";           [[ -z "$(run_claim c6 '改了設定，attempted, unverified')" ]]        || { echo "FAIL: self-labelled reply blocked" >&2; exit 1; }
ledger_for c7 "$BEFORE";           [[ -z "$(run_claim c7 'The claim-evidence-gate blocks a `done` claim; 「完成宣告 gate」 is discussed here, and Completion claim text is quoted')" ]] || { echo "FAIL: discussing the gate treated as a claim" >&2; exit 1; }
ledger_for c8 "$BEFORE" "$RUN0";   [[ "$(run_claim c8 'the worker is stuck, no reply for 30 min')" == block ]] || { echo "FAIL: negative claim on one call not blocked" >&2; exit 1; }
ledger_for c9 "$BEFORE" "$RUN0" "$READ"; [[ -z "$(run_claim c9 'the worker is stuck, no reply for 30 min')" ]] || { echo "FAIL: corroborated negative claim blocked" >&2; exit 1; }
ledger_for c10 "$BEFORE";          run_claim c10 '搞定了' >/dev/null; [[ -z "$(run_claim c10 '搞定了')" ]]  || { echo "FAIL: gate fired twice for the same reply" >&2; exit 1; }
TR4="$WORK/transcript-title.jsonl"
printf '%s\n' '{"type":"user","timestamp":"2026-01-01T00:00:00.000Z","message":{"content":"go"}}' '{"type":"custom-title","customTitle":"✅ foo — shipped · .1-abcd1234"}' > "$TR4"
ledger_for c11 "$RUN0";            [[ "$(run_claim c11 'see above' "$TR4")" == block ]]               || { echo "FAIL: ✅ title without quoted evidence not blocked" >&2; exit 1; }
ledger_for c12 "$RUN0";            [[ -z "$(run_claim c12 'exit=0' "$TR4")" ]]                        || { echo "FAIL: ✅ title with bound evidence blocked" >&2; exit 1; }

# bol: build-shaped brief must carry a runnable check; research brief need not
if run_bol 'GOAL: implement retry in client.ts ACCEPTANCE: retries work REPORT: summary'; then echo "FAIL: build brief without runnable check not blocked" >&2; exit 1; fi
run_bol 'GOAL: implement retry in client.ts ACCEPTANCE: `npm test` exits 0 REPORT: exit code + key lines' || { echo "FAIL: build brief with backtick command blocked" >&2; exit 1; }
run_bol 'GOAL: fix flaky test ACCEPTANCE: flutter test test/reward exits 0 REPORT: exit code' || { echo "FAIL: build brief with bare runner blocked" >&2; exit 1; }
run_bol 'GOAL: Answer: which SDK version ACCEPTANCE: every claim cited REPORT: path + summary' || { echo "FAIL: research brief blocked for lacking a command" >&2; exit 1; }
tail -4 "$TEST_DATA/agent-hooks/bol-prompt-stats.jsonl" | head -1 | jq -e '.result == "fail" and .missing == ["RUNNABLE_CHECK"] and .blocked == true' >/dev/null

# deny-replay: the same (tool, input) that a gate BLOCKED earlier is short-circuited; a fresh input and a plain error are not
TR5="$WORK/transcript-deny.jsonl"
printf '%s\n' \
  '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Bash","input":{"command":"gated-cmd --foreground"}}]}}' \
  '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","is_error":true,"content":"BLOCKED: gated-cmd must not run in the foreground"}]}}' \
  '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t2","name":"Bash","input":{"command":"npm test"}}]}}' \
  '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t2","is_error":true,"content":"Exit code 1\n3 failing"}]}}' > "$TR5"
run_deny() { printf '%s' "$(jq -cn --arg tp "$TR5" --arg c "$1" '{tool_name:"Bash",transcript_path:$tp,tool_input:{command:$c}}')" \
  | HOME="$TEST_HOME" XDG_DATA_HOME="$TEST_DATA" bash "$ROOT/.agents/hooks/deny-replay-gate.sh" >/dev/null 2>&1; }
if run_deny 'gated-cmd --foreground'; then echo "FAIL: replay of a BLOCKED call was not short-circuited" >&2; exit 1; fi
run_deny 'npm test'  || { echo "FAIL: re-running a plain failing command was blocked" >&2; exit 1; }
run_deny 'ls -la'    || { echo "FAIL: a fresh call was blocked" >&2; exit 1; }
check_jsonl "$TEST_DATA/agent-hooks/deny-replay-stats.jsonl" 3 '(.tool=="Bash") and (.replay_blocked|type)=="boolean"'
[[ "$(jq -r 'select(.replay_blocked==true)|.tool' "$TEST_DATA/agent-hooks/deny-replay-stats.jsonl" | wc -l | tr -d ' ')" == 1 ]]

echo "JSONL hooks smoke: bol denies incomplete briefs + build briefs without a runnable check; concurrency gate denies the 6th subagent; audit redacted; device flag scoped; compaction recall re-injects + escalates at 3; ledger carries normalized evidence tokens only; claim gate binds done/stuck claims to the ledger; deny-replay short-circuits a replayed BLOCKED call"
