#!/usr/bin/env python3
"""Pipe-level regression test for codex-cu-proxy against a fake child (no real MCP).

Cases come from the 2026-10-08 Sol review: accept, forward round trip, quiet child
death, slow-client tail drain, two-way backpressure, non-UTF-8 policy, and the
second-round lifecycle cases: stalled client, child stdin death, approval after client EOF,
and the third-round cases: closed stderr on a fatal error, client EOF during the policy read.
Usage: python3 test-codex-cu-proxy   (exit 0 = all PASS; ~30 s)
"""
import json, os, subprocess, sys, tempfile, threading, time
from pathlib import Path

PROXY = str(Path(__file__).resolve().parent / "codex-cu-proxy")
BIG = 2_000_000
CALC = 'Allow Computer Use to use "Calculator"?'
FAKE = r'''
import json, os, sys, time
def emit(v): print(json.dumps(v), flush=True)
mode = os.environ["FAKE_MODE"]
if mode == "death":
    emit({"last": True}); sys.exit(17)
sys.stdin.readline()                                   # initialize
emit({"ready": True})
if mode == "writerdeath":
    os.close(0); emit({"closed_stdin": True}); time.sleep(15); sys.exit(0)
if mode == "eofapproval":
    time.sleep(0.3)
    emit({"jsonrpc": "2.0", "id": "app", "method": "elicitation/create", "params": {"message": %r}})
    emit({"approval_line": sys.stdin.readline()}); sys.exit(0)
if mode == "tail":
    emit({"tail": "x" * %d}); sys.exit(0)
if mode == "deadlock":
    sys.stdin.readline(); time.sleep(0.2)
    emit({"jsonrpc": "2.0", "id": "app", "method": "elicitation/create", "params": {"message": %r}})
    emit({"bulk": "x" * %d})
    sys.stdin.readline(); sys.stdin.readline()          # approval reply + big tools/call
    emit({"completed": True}); sys.exit(0)
emit({"jsonrpc": "2.0", "id": "app", "method": "elicitation/create", "params": {"message": %r}})
emit({"got": json.loads(sys.stdin.readline())}); sys.exit(0)
''' % (CALC, BIG, CALC, BIG, CALC)

tmp = Path(tempfile.mkdtemp())
child = tmp / "fake-child"
child.write_text("#!" + sys.executable + "\n" + FAKE)
child.chmod(0o755)


def init(caps):
    return json.dumps({"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {"capabilities": caps}}) + "\n"


def start(mode, policy, **extra):
    pol = tmp / "approve"
    pol.write_bytes(policy)
    env = dict(os.environ, CU_CHILD=str(child), CU_APPROVE_FILE=str(pol), FAKE_MODE=mode, **extra)
    return subprocess.Popen([sys.executable, PROXY], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, env=env)


def lines(p, n, timeout):
    out, box = [], {}
    def rd():
        for _ in range(n):
            l = p.stdout.readline()
            if not l:
                break
            out.append(l)
    t = threading.Thread(target=rd, daemon=True); t.start(); t.join(timeout)
    return out


results = []
def check(name, ok, detail=""):
    results.append(ok)
    print(("PASS " if ok else "FAIL ") + name + ("" if ok else f" -- {detail}"))


# 1. accept: policy `all` answers the prompt; the child receives accept
p = start("normal", b"# c\nall\n"); p.stdin.write(init({}).encode()); p.stdin.flush()
got = [json.loads(l) for l in lines(p, 2, 10)]
p.kill()
check("accept under `all`", len(got) == 2 and got[1].get("got", {}).get("result") == {"action": "accept", "content": {}}, got)

# 2. forward: unlisted app + client that elicits -> client sees prompt, its reply reaches the child
p = start("normal", b"TextEdit\n"); p.stdin.write(init({"elicitation": {}}).encode()); p.stdin.flush()
got = [json.loads(l) for l in lines(p, 2, 10)]
fwd = len(got) == 2 and got[1].get("method") == "elicitation/create"
p.stdin.write(json.dumps({"jsonrpc": "2.0", "id": "app", "result": {"action": "decline"}}).encode() + b"\n"); p.stdin.flush()
back = [json.loads(l) for l in lines(p, 1, 10)]
p.kill()
check("forward round trip", fwd and back and back[0]["got"]["result"] == {"action": "decline"}, (got, back))

# 3. quiet child death: last line delivered, child's code returned
p = start("death", b"all\n")
out = lines(p, 1, 10); rc = p.wait(10)
check("child death ends proxy", rc == 17 and out and json.loads(out[0]) == {"last": True}, (rc, out))

# 4. slow client: child exits right after a 2 MB line; client waits past the drain idle limit
p = start("tail", b"all\n"); p.stdin.write(init({}).encode()); p.stdin.flush()
lines(p, 1, 10); time.sleep(6.5)
tail = p.stdout.readline(); rc = p.wait(15)
check("tail delivered whole to a slow client", rc == 0 and len(tail) == BIG + len('{"tail": ""}') + 1 and tail.endswith(b"\n"), (rc, len(tail)))

# 5. two-way backpressure: big client->child and child->client at once, plus an approval
p = start("deadlock", b"all\n")
p.stdin.write(init({}).encode() + b'{"jsonrpc":"2.0","method":"notifications/start"}\n'); p.stdin.flush()
big = json.dumps({"jsonrpc": "2.0", "id": 9, "method": "tools/call", "params": {"name": "js", "x": "y" * BIG}}) + "\n"
threading.Thread(target=lambda: (p.stdin.write(big.encode()), p.stdin.flush()), daemon=True).start()
out = lines(p, 3, 20)
p.kill()
check("no deadlock under two-way backpressure", len(out) == 3 and json.loads(out[2]) == {"completed": True}, [l[:40] for l in out])

# 6. non-UTF-8 policy: logged, treated as absent (decline for a non-eliciting client), connection lives
p = start("normal", b"\xca\xfe\xba\xbe\n"); p.stdin.write(init({}).encode()); p.stdin.flush()
got = [json.loads(l) for l in lines(p, 2, 10)]
p.kill(); err = p.stderr.read().decode()
check("bad policy fails closed and keeps going", len(got) == 2 and got[1]["got"]["result"] == {"action": "decline"} and "cannot read" in err, (got, err[-200:]))

# 7. client stops reading for good after child exit: proxy gives up non-zero, never hangs
p = start("tail", b"all\n", CU_DRAIN_IDLE_S="2"); p.stdin.write(init({}).encode()); p.stdin.flush()
lines(p, 1, 10)
try:
    rc = p.wait(15)
except subprocess.TimeoutExpired:
    rc = "hung"; p.kill()
err = p.stderr.read().decode()
check("stalled client ends proxy non-zero", rc not in (0, "hung") and "may be incomplete" in err, (rc, err[-160:]))

# 8. child closes its stdin but stays alive: the next client line ends the proxy non-zero
p = start("writerdeath", b"all\n"); p.stdin.write(init({}).encode()); p.stdin.flush()
lines(p, 2, 10)
p.stdin.write(b'{"jsonrpc":"2.0","id":5,"method":"ping"}\n'); p.stdin.flush()
try:
    rc = p.wait(10)
except subprocess.TimeoutExpired:
    rc = "hung"; p.kill()
check("child stdin death ends proxy non-zero", rc not in (0, "hung"), rc)

# 9. client closes stdin, then an approval arrives: logged as dropped, never claimed as accepted
p = start("eofapproval", b"all\n"); p.stdin.write(init({}).encode()); p.stdin.flush(); p.stdin.close()
out = [json.loads(l) for l in lines(p, 2, 10)]
p.wait(10); err = p.stderr.read().decode()
check("approval after client EOF is dropped, not claimed", "dropped" in err and "elicitation accept" not in err
      and out[-1:] == [{"approval_line": ""}], (out, err[-200:]))

# 10. child stdin death while proxy stderr is closed: diagnostics fail, the exit still happens
p = start("writerdeath", b"all\n"); p.stdin.write(init({}).encode()); p.stdin.flush()
lines(p, 2, 10); p.stderr.close()
p.stdin.write(b'{"jsonrpc":"2.0","id":5,"method":"ping"}\n'); p.stdin.flush()
try:
    rc = p.wait(10)
except subprocess.TimeoutExpired:
    rc = "hung"; p.kill()
check("closed stderr does not block the exit", rc not in (0, "hung"), rc)


# 11. client EOF lands during the policy read (a FIFO holds the read open)
def eof_during_policy_read(policy, caps):
    fifo = tmp / "approve-fifo"
    if fifo.exists():
        fifo.unlink()
    os.mkfifo(fifo)
    env = dict(os.environ, CU_CHILD=str(child), CU_APPROVE_FILE=str(fifo), FAKE_MODE="normal")
    p = subprocess.Popen([sys.executable, PROXY], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    p.stdin.write(init(caps).encode()); p.stdin.flush()
    lines(p, 1, 10)                                     # ready
    deadline = time.time() + 10
    while True:                                         # opens only once the proxy is reading the policy
        try:
            fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK); break
        except OSError:
            if time.time() > deadline:
                p.kill(); return "no policy read", "", []
            time.sleep(0.02)
    p.stdin.close(); time.sleep(0.3)
    os.write(fd, policy); os.close(fd)
    out = lines(p, 2, 10)
    try:
        rc = p.wait(10)
    except subprocess.TimeoutExpired:
        rc = "hung"; p.kill()
    return rc, p.stderr.read().decode(), out

rc, err, out = eof_during_policy_read(b"all\n", {})
check("EOF during policy read: accept dropped, not claimed", rc != "hung" and "dropped" in err and "elicitation accept" not in err, (rc, err[-200:]))
rc, err, out = eof_during_policy_read(b"TextEdit\n", {"elicitation": {}})
check("EOF during policy read: prompt not forwarded", rc != "hung" and "dropped" in err and not any(b"elicitation/create" in l for l in out), (rc, err[-200:], out))

print(f"{sum(results)}/{len(results)} PASS")
sys.exit(0 if all(results) else 1)
