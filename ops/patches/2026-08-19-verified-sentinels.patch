 # Record that the result-path instruction has been delivered. Call ONLY after
 # the send has gone through, so a failed first send never leaves a worker that
 # silently never learned its result path (#283).
 result_path_mark_injected() {
-  : > "$(result_path_sentinel "$1")" 2>/dev/null || true
+  local name="$1" session="${2:-}"
+  if [[ -n "$session" ]] && ! _sentinel_landed "$session" "$RESULT_PATH_MARKER"; then
+    return 1
+  fi
+  : > "$(result_path_sentinel "$name")" 2>/dev/null || true
 }
 
