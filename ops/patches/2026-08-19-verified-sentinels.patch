+# Record delivery of the scope guard. With a session argument the sentinel is
+# written ONLY when the guard text is visible in the pane; not writing it means
+# the next send re-injects (should_inject is sentinel-gated), which is the
+# desired self-heal. Callers whose delivery is argv-based (oneshot) pass no
+# session: there is no pane echo to verify and argv delivery cannot half-land.
 task_scope_guard_mark_injected() {
-  : > "$(task_scope_guard_sentinel "$1")" 2>/dev/null || true
+  local name="$1" session="${2:-}"
+  if [[ -n "$session" ]] && ! _sentinel_landed "$session" "$TASK_SCOPE_GUARD_MARKER"; then
+    return 1
+  fi
+  : > "$(task_scope_guard_sentinel "$name")" 2>/dev/null || true
 }
 
