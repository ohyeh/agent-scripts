<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: sed "s#__HOME__#$HOME#g" ops/com.ohyeh.reap-orphan-browsers.plist > ~/Library/LaunchAgents/com.ohyeh.reap-orphan-browsers.plist &&
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ohyeh.reap-orphan-browsers.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ohyeh.reap-orphan-browsers</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/github/agent-scripts/scripts/reap-orphan-browsers.sh</string></array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/reap-orphan-browsers.err</string>
</dict>
</plist>
